# ---- App ----
APP_NAME=openshop
APP_ENV=development
LOG_LEVEL=debug
APP_CURRENCY=CNY
ORDER_TTL=30m
PASSWORD_RESET_URL=http://localhost:5173/reset-password
EMAIL_VERIFY_URL=http://localhost:5173/verify-email
PUBLIC_SITE_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=false
TAX_RATE_BPS=0
LOW_STOCK_THRESHOLD=5

# ---- HTTP ----
HTTP_ADDR=:8080
# The operations (admin) binary listens here; deploy it on an internal network.
OPS_ADDR=:8081
HTTP_CORS_ORIGINS=http://localhost:5173
HTTP_RATE_LIMIT_RPS=100
HTTP_RATE_LIMIT_USER_RPS=100
# Per-IP and per-user requests allowed per trailing one-second sliding window.
# Comma-separated CIDRs whose X-Forwarded-For is trusted (ingress/LB).
# HTTP_TRUSTED_PROXIES=10.0.0.0/8

# ---- Postgres ----
POSTGRES_DSN=host=localhost port=5432 user=openshop password=openshop dbname=openshop sslmode=disable TimeZone=UTC
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_AUTO_MIGRATE=false

# ---- Redis (shared cache, locks, carts) ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- NATS (JetStream required) ----
NATS_URL=nats://localhost:4222
NATS_STREAM=OPENSHOP

# ---- Auth ----
JWT_SECRET=dev-insecure-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=720h

# ---- Payment ----
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_RETURN_URL=http://localhost:8080/payment/result
# Real gateway secrets stay in the environment (never the settings table).
# Registering a key enables the provider; pick it at runtime in the ops console.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Alipay ----
# The app id is public; the keys are secrets. A gateway is registered only when
# its credentials are complete, and it is switched on at runtime in the ops
# console (payment.enabled_providers). Values accept PEM or single-line base64.
ALIPAY_APP_ID=
# The application's RSA2 private key (PKCS#1 or PKCS#8).
ALIPAY_PRIVATE_KEY=
# Alipay's public key, used to verify the asynchronous notification signature.
ALIPAY_PUBLIC_KEY=
# Leave empty for production; point at the sandbox to try it out.
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ---- WeChat Pay (API v3, Native) ----
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
# Serial number of the merchant certificate whose key signs the requests.
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
# The API v3 key (32 characters) decrypts notification resources.
WECHAT_PAY_API_V3_KEY=
# WeChat's platform certificate, used to verify notification signatures.
WECHAT_PAY_PLATFORM_CERT=
# WECHAT_PAY_GATEWAY=https://api.mch.weixin.qq.com

# ---- Social sign in (WeChat / Alipay) ----
# The provider toggles and app ids are runtime settings (ops console, group
# "auth"); only the secrets live here. The callback URL is derived from
# store.public_url: <public url>/api/v1/auth/social/<provider>/callback.
WECHAT_APP_SECRET=
ALIPAY_PRIVATE_KEY=
# WECHAT_API_BASE=
# ALIPAY_AUTH_URL=

# ---- Storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- Mail / SMS ----
MAIL_DRIVER=log
SMS_DRIVER=log

# ---- Workers ----
WORKER_ENABLED=true
ORDER_SWEEP_INTERVAL=1m
ORDER_SWEEP_BATCH=100
OUTBOX_INTERVAL=1s
OUTBOX_BATCH=100
# How often held referral commissions are paid into the referrer's wallet.
COMMISSION_SETTLE_INTERVAL=10m

# ---- Tracing (OpenTelemetry) ----
# Leave the endpoint empty to disable tracing (no-op tracer).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_INSECURE=true
OTEL_SAMPLE_RATIO=1.0

# Public sign-up (set false to close registration).
ALLOW_REGISTRATION=true
# OIDC single sign-on. Providers (id/name/issuer/clientId/redirectUrl/scopes)
# are configured in the ops console; only secrets stay in the environment.
# Either a single secret (legacy single provider) or a JSON map keyed by the
# provider id, e.g. OIDC_CLIENT_SECRETS={"google":"xxx","keycloak":"yyy"}.
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRETS=
