# ---- App ----
APP_NAME=openshop
APP_ENV=development
LOG_LEVEL=debug
APP_CURRENCY=CNY
ORDER_TTL=30m

# ---- HTTP ----
HTTP_ADDR=:8080
HTTP_CORS_ORIGINS=http://localhost:5173
HTTP_RATE_LIMIT_RPS=100

# ---- Postgres ----
POSTGRES_DSN=host=localhost port=5432 user=openshop password=openshop dbname=openshop sslmode=disable TimeZone=UTC
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_AUTO_MIGRATE=false

# ---- Redis (shared cache, locks, carts) ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- NATS (JetStream required) ----
NATS_URL=nats://localhost:4222
NATS_STREAM=OPENSHOP

# ---- Auth ----
JWT_SECRET=dev-insecure-change-me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=720h

# ---- Payment ----
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_RETURN_URL=http://localhost:5173/payment/result

# ---- Storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- Mail / SMS ----
MAIL_DRIVER=log
SMS_DRIVER=log

# ---- Workers ----
WORKER_ENABLED=true
ORDER_SWEEP_INTERVAL=1m
ORDER_SWEEP_BATCH=100
